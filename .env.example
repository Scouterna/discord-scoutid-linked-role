# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_PUBLIC_KEY=your_public_key
DISCORD_REDIRECT_URI=https://your-server/discord-oauth-callback
DISCORD_VALIDATION_URL=https://your-server/linked-role
DISCORD_GUILD_ID=your_guild_id

# ScoutID (OIDC)
SCOUTID_CLIENT_ID=your_scoutid_client_id
SCOUTID_CLIENT_SECRET=your_scoutid_client_secret
SCOUTID_REDIRECT_URI=https://your-server/scoutid-oauth-callback
# Optional, defaults to "openid profile email"
SCOUTID_SCOPES=openid profile email

# ScoutNet event (optional — omit to assign only the scout role)
SCOUTNET_EVENT_ID=your_event_id
SCOUTNET_PARTICIPANTS_APIKEY=your_api_key

# Marker roles: every linked user / every event registrant
SCOUTNET_SCOUT_ROLE=scout
SCOUTNET_EVENT_ROLE=participant

# Fee-based roles — fee_id:category
# Maps a ScoutNet fee_id to a category name used for role assignment.
SCOUTNET_FEE_ROLES=25694:deltagare,25696:ist,25702:ist-direktresa,33293:ledare,25697:cmt

# Division roles — category:questionId:roleWithDiv:roleWithoutDiv
# Each category reads its division number from its own ScoutNet question.
# {div} is the zero-padded (min 2 digits) division number. A category left out
# here gets a role named after the category itself (e.g. "cmt").
SCOUTNET_DIVISION_ROLES=deltagare:88168:Deltagare-{div}:Deltagare-Väntande,ist:88168:IST-Patrull-{div}:IST-Väntande,ledare:107592:Ledare-{div}:Ledare-Väntande

# Nickname suffixes — category:withDiv:withoutDiv (empty = no suffix)
# Produces e.g. "Ida Sandholdt (12)", "Erik Reiner (AL12)", "Per Persson (IST-17)".
SCOUTNET_NICKNAME_SUFFIXES=deltagare:{div}:,ledare:AL{div}:AL,ist:IST-{div}:IST,ist-direktresa::IST,cmt::CMT

# General
PORT=3000
COOKIE_SECRET=generate_a_random_secret

# Azure Table Storage (links, OAuth tokens, OAuth state).
# The value below is the well-known Azurite emulator connection string used by
# docker-compose.yml; in production this is the storage account's own string.
TABLE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;TableEndpoint=http://azurite:10002/devstoreaccount1;
TABLE_NAME=scoutidlinks

# ngrok — local development only, gives Discord an HTTPS URL to reach
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_URL=your_ngrok_url
