node_modules
.DS_Store
npm-debug.log*
logs/
# Local npm registry override, used by the Docker build if present
.npmrc
.env
.env.*
!.env.example
scoutid-metadata.json
.claude/*.local.json

# Azure CLI config and token cache. AZURE_CONFIG_DIR may point at a directory
# inside a checkout, and this repository is public.
.azure*

# Kubeconfigs hold long-lived service-account tokens; they live in ~/.kube
**/kubeconfig*
**/kubectl
**/*.kubeconfig

# Local working notes. Deliberately not published: this repository is public,
# and such notes can quote resource names, hostnames and operational detail
# that do not need to be.
docs/

# Working scratch for the agent flow, in campfire's shape: requirements, design
# and plan documents for one piece of work. The durable record is the code, the
# documentation and the commit message — a plan that outlives its branch is a
# second description of the system that nothing keeps true.
.agents/specs/
